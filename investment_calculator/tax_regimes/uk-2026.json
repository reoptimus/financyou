{
  "$schema": "./schema.json",
  "schema_version": "0.1",
  "id": "uk-2026",
  "country": { "code": "GB", "name": "United Kingdom", "locale": "en-GB" },
  "fiscal_year": 2026,
  "currency": "GBP",

  "status": "draft",
  "validation": {
    "validated_by": null,
    "validated_on": null,
    "golden_cases": null,
    "reviewed_by_professional": false
  },

  "sources": [
    {
      "label": "AUCUNE — portage mécanique des constantes qui figuraient en dur dans tax_engine.TaxConfigPreset",
      "covers": ["income_tax", "flat_tax", "wrappers", "social_contributions"]
    }
  ],

  "known_gaps": [
    "STATUT BROUILLON : valeurs reprises telles quelles de l'ancien code, jamais vérifiées contre une source officielle.",
    "Le barème réel (personal allowance, basic, higher, additional rate) n'est pas modélisé : l'ancien code appliquait un taux unique de 40 %.",
    "Abattement annuel de plus-value et abattement sur dividendes non modélisés.",
    "Pension et son allègement fiscal à l'entrée non modélisés.",
    "Retrait de pension avant l'âge minimal : la charge applicable n'est pas modélisée, la règle par défaut applique le barème sans pénalité, ce qui sous-estime l'impôt.",
    "Attention : l'identifiant du régime utilise le préfixe uk pour rester lisible, alors que le code pays ISO du Royaume-Uni est GB."
  ],

  "social_contributions": {
    "investment_income": {
      "label": "National Insurance (approximation reprise de l'ancien code)",
      "rate": 0.12,
      "applies_to": ["earned_income"]
    }
  },

  "income_tax": {
    "label": "Income tax (taux moyen approché)",
    "mode": "progressive",
    "brackets": [
      { "lower": 0, "upper": null, "rate": 0.40 }
    ],
    "household_quotient": { "enabled": false }
  },

  "flat_tax": {
    "enabled": true,
    "label": "Capital gains tax (taux moyen approché)",
    "income_tax_rate": 0.20,
    "social_rate": 0.0,
    "applies_to": ["capital_gains"],
    "progressive_option": false
  },

  "wrappers": [
    {
      "id": "general_investment_account",
      "label": "General investment account",
      "tax_treatment": "taxable",
      "contribution_limit": null,
      "contribution_deductible": false,
      "eligible_assets": ["equity", "bond", "fund", "etf", "money_market"],
      "growth_taxed_annually": false,
      "withdrawal_rules": [
        {
          "label": "Capital gains tax on disposal",
          "income_tax_rate": "flat_tax",
          "social_rate": "none",
          "taxable_base": "gain_only"
        }
      ]
    },
    {
      "id": "isa",
      "label": "Individual savings account",
      "tax_treatment": "tax_free",
      "contribution_limit": 20000,
      "contribution_limit_period": "annual",
      "contribution_deductible": false,
      "eligible_assets": ["equity", "bond", "fund", "etf", "money_market"],
      "growth_taxed_annually": false,
      "withdrawal_rules": [
        {
          "label": "Withdrawal, fully exempt",
          "income_tax_rate": 0.0,
          "social_rate": "none",
          "taxable_base": "gain_only"
        }
      ]
    },
    {
      "id": "pension",
      "label": "Personal pension",
      "tax_treatment": "tax_deferred",
      "contribution_limit": 60000,
      "contribution_limit_period": "annual",
      "contribution_deductible": true,
      "eligible_assets": ["equity", "bond", "fund", "etf", "money_market"],
      "growth_taxed_annually": false,
      "withdrawal_rules": [
        {
          "label": "Withdrawal from age 55",
          "when": { "age": { "gte": 55 } },
          "income_tax_rate": "progressive",
          "social_rate": "none",
          "taxable_base": "full_withdrawal"
        },
        {
          "label": "Accès avant l'âge minimal — pénalité réelle non modélisée, valeur provisoire",
          "income_tax_rate": "progressive",
          "social_rate": "none",
          "taxable_base": "full_withdrawal"
        }
      ]
    }
  ],

  "wealth_tax": { "enabled": false }
}
