      "contribution_limit": 150000,
      "contribution_limit_period": "lifetime",
      "contribution_deductible": false,
      "eligible_assets": ["equity_eu", "fund_eu", "etf_eu"],
      "growth_taxed_annually": false,
      "withdrawal_rules": [
        {
          "label": "Retrait après cinq ans",
          "when": { "holding_years": { "gte": 5 } },
          "income_tax_rate": 0.0,
          "social_rate": "standard",
          "taxable_base": "proportional_gain"
