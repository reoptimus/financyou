      "tax_treatment": "conditional",
      "contribution_limit": null,
      "contribution_deductible": false,
      "eligible_assets": ["equity", "bond", "fund", "etf", "euro_fund", "real_estate_fund"],
      "growth_taxed_annually": false,
      "withdrawal_rules": [
        {
          "label": "Rachat après huit ans, primes versées inférieures au seuil",
          "when": { "holding_years": { "gte": 8 }, "premiums_paid": { "lte": 150000 } },
          "income_tax_rate": 0.075,
          "social_rate": "standard",
          "allowance": {
            "amount_single": 4600,
            "amount_couple": 9200,
            "period": "annual",
            "against": "income_tax"
          },
          "taxable_base": "proportional_gain"
        },
        {
          "label": "Rachat après huit ans, part des primes au-delà du seuil",
          "when": { "holding_years": { "gte": 8 } },
          "income_tax_rate": 0.128,
          "social_rate": "standard",
          "allowance": {
            "amount_single": 4600,
            "amount_couple": 9200,
            "period": "annual",
            "against": "income_tax"
          },
          "taxable_base": "proportional_gain"
        },
        {
          "label": "Rachat avant huit ans",
          "income_tax_rate": 0.128,
          "social_rate": "standard",
          "taxable_base": "proportional_gain"
        }
      ]
    },
    {
      "id": "per",
      "label": "Plan d'épargne retraite",
      "description": "Versements déductibles du revenu imposable dans la limite d'un plafond ; imposition à la sortie.",
      "tax_treatment": "tax_deferred",
      "contribution_limit": null,
      "contribution_deductible": true,
      "contribution_deduction_cap": null,
      "eligible_assets": ["equity", "bond", "fund", "etf", "euro_fund"],
      "growth_taxed_annually": false,
      "withdrawal_rules": [
        {
          "label": "Sortie en capital à la retraite, versements déduits à l'entrée",
          "when": { "exit_form": "lump_sum" },
          "income_tax_rate": "progressive",
          "social_rate": "standard",
          "taxable_base": "full_withdrawal"
        },
        {
          "label": "Sortie en rente",
          "income_tax_rate": "progressive",
          "social_rate": "standard",
          "taxable_base": "full_withdrawal"
        }
      ]
    },
    {
      "id": "livret_a",
      "label": "Livret A",
      "description": "Exonéré d'impôt sur le revenu et de prélèvements sociaux.",
      "tax_treatment": "tax_free",
      "contribution_limit": 22950,
      "contribution_limit_period": "lifetime",
      "contribution_deductible": false,
      "eligible_assets": ["money_market"],
      "growth_taxed_annually": false,
      "withdrawal_rules": [
        {
          "label": "Retrait, exonération totale",
          "income_tax_rate": 0.0,
          "social_rate": "none",
          "taxable_base": "gain_only"
        }
      ]
    },
    {
      "id": "immobilier_direct",
      "label": "Immobilier détenu en direct",
      "description": "Revenus fonciers imposés au barème ; plus-values soumises aux abattements pour durée de détention.",
      "tax_treatment": "taxable",
      "contribution_limit": null,
      "contribution_deductible": false,
      "eligible_assets": ["real_estate"],
      "growth_taxed_annually": true,
      "withdrawal_rules": [
