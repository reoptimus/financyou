  "wrappers": [
    {
      "id": "cto",
      "label": "Compte-titres ordinaire",
      "description": "Aucune contrainte de versement ni d'actif éligible ; imposition des gains à leur réalisation.",
      "tax_treatment": "taxable",
      "contribution_limit": null,
      "contribution_deductible": false,
