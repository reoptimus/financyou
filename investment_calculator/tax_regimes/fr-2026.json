      { "lower": 0, "upper": 11600, "rate": 0.0 },
      { "lower": 11600, "upper": 29579, "rate": 0.11 },
      { "lower": 29579, "upper": 84577, "rate": 0.30 },
      { "lower": 84577, "upper": 181917, "rate": 0.41 },
